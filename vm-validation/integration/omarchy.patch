+'
diff --git a/bin/omarchy-system-lid-close b/bin/omarchy-system-lid-close
index eb3dc097efbbafed6f37116caa313deddc673572..64711dbe5eb58a3760c1c53b9d93a9528bfc8485 100755
--- a/bin/omarchy-system-lid-close
+++ b/bin/omarchy-system-lid-close
@@ -10,10 +10,10 @@
 # closes gives Quickshell a head start before logind even decides to suspend.
