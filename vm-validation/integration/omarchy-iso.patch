index 0000000000000000000000000000000000000000..c1913bfcea425ae396aed015044169fedfd952f5
--- /dev/null
+++ b/builder/reuse-verified-package.sh
@@ -0,0 +1,44 @@
+#!/bin/bash
+# Opt-in reuse of actual passing build artifacts; source and bytes must match.
+set -euo pipefail
+mirror=$1
+package=$2
+receipt=/var/cache/intel-mac-build/verified-reuse.json
+[[ -f $receipt ]] || exit 1
+mapfile -t artifacts < <(python - "$receipt" "$mirror" "$package" <<'PY'
+import hashlib, json, pathlib, subprocess, sys
+receipt, mirror, package = sys.argv[1:]
+data = json.loads(pathlib.Path(receipt).read_text())
+for name, path in [('omarchy', '/omarchy-source'), ('omarchy-pkgs', '/omarchy-pkgs')]:
+    head = subprocess.check_output(['git', '-c', f'safe.directory={path}', '-C', path, 'rev-parse', 'HEAD'], text=True).strip()
+    if data['input_commits'][name] != head:
+        sys.exit(1)
+entries = data['packages'].get(package, [])
+if not entries:
+    sys.exit(1)
+for entry in entries:
+    filename = entry['filename']
+    if pathlib.Path(filename).name != filename:
+        sys.exit(1)
+    artifact = pathlib.Path(mirror) / filename
+    if not artifact.is_file() or hashlib.file_digest(artifact.open('rb'), 'sha256').hexdigest() != entry['sha256']:
+        sys.exit(1)
+for entry in entries:
+    print(pathlib.Path(mirror) / entry['filename'])
+PY
+)
+(( ${#artifacts[@]} )) || exit 1
+primary=false
+for artifact in "${artifacts[@]}"; do
+  read -r name _ < <(pacman -Qp "$artifact")
+  [[ $name == "$package" ]] && primary=true
+done
+$primary || exit 1
+# A local rebuild can keep its filename while changing its archive checksum.
+# Refresh this task's dedicated pacman cache before any dependency transaction.
+for artifact in "${artifacts[@]}"; do
+  cached="/var/cache/pacman/pkg/$(basename "$artifact")"
+  rm -f "$cached.sig"
+  cp "$artifact" "$cached"
+done
+echo "Reusing verified build artifact for $package (matching source commits and SHA256)."
