+++ b/builder/build-intel-mac-packages.sh
@@ -0,0 +1,93 @@
+#!/bin/bash
+# Local validation only: build the actual companion recipes, including checks.
+set -euo pipefail
+
+offline_mirror_dir=$1
+work_dir=/var/cache/intel-mac-build
+mkdir -p "$work_dir" "$offline_mirror_dir"
+chown builder:builder "$work_dir"
+
+# Read the selected runtime's real package version; never advertise a made-up
+# stable version to satisfy the optional desktop integration dependency.
+runtime_dependency=''
+for artifact in "$offline_mirror_dir/omarchy-dev-"*.pkg.tar.zst; do
+  [[ -f $artifact ]] || continue
+  read -r artifact_name artifact_version < <(pacman -Qp "$artifact")
+  [[ $artifact_name == omarchy-dev ]] || continue
+  [[ -z $runtime_dependency ]] || { echo 'ERROR: multiple local runtimes.' >&2; exit 1; }
+  runtime_dependency="$artifact_name=$artifact_version"
+done
+
+# Resolve dependencies against the exact locally built packages first. This
+# repository is used only inside the disposable build container.
+repo-add "$offline_mirror_dir/intel-mac-local.db.tar.gz" "$offline_mirror_dir/"*.pkg.tar.zst
+awk -v mirror="$offline_mirror_dir" '
+  !added && /^\[core\]/ {
+    print "[intel-mac-local]\nSigLevel = Never\nServer = file://" mirror "\n"
+    added = 1
+  }
+  { print }
+' /etc/pacman.conf > /tmp/pacman-intel-mac-build.conf
+cp /tmp/pacman-intel-mac-build.conf /etc/pacman.conf
+
+failed=()
+while IFS= read -r pkg; do
+  [[ -n $pkg && $pkg != \#* ]] || continue
+  if bash /builder/reuse-verified-package.sh "$offline_mirror_dir" "$pkg"; then
+    continue
+  fi
+  echo "Building Intel Mac companion: $pkg"
+  pkg_work="$work_dir/$pkg"
+  mkdir -p "$pkg_work"
+  cp -a "/omarchy-pkgs/pkgbuilds/$pkg/." "$pkg_work/"
+  # This is a dedicated build directory. Preserve downloaded sources, but do
+  # not let an older output masquerade as an artifact of this attempt.
+  find "$pkg_work" -maxdepth 1 -type f -name '*.pkg.tar.zst' -delete
+  chown -R builder:builder "$pkg_work"
+
+  pacman -Sy --noconfirm
+  local_runtime_env=()
+  if [[ $pkg == t1bridge-omarchy && -n $runtime_dependency ]]; then
+    local_runtime_env=("OMARCHY_LOCAL_RUNTIME_DEPENDENCY=$runtime_dependency")
+  fi
+  # Do not disable source verification, dependency resolution, or check().
+  # USB replay tests timed out under default parallelism in this quota-limited
+  # container. All 131 libfprint tests passed twice serially; retain every test.
+  if ! env "${local_runtime_env[@]}" su builder -c "cd '$pkg_work' && PKGDEST='$pkg_work' MAKEFLAGS=-j4 CARGO_BUILD_JOBS=4 MESON_NUM_PROCESSES=1 makepkg --syncdeps --noconfirm --force --cleanbuild" </dev/null; then
+    failed+=("$pkg")
+    echo "ERROR: companion build failed: $pkg; continuing independent builds." >&2
+    continue
+  fi
+
+  # --packagelist predicts a -debug archive even when a data-only package
+  # produces no debug symbols. Publish actual outputs, requiring the primary.
+  mapfile -t artifacts < <(find "$pkg_work" -maxdepth 1 -type f -name '*.pkg.tar.zst' | sort)
+  primary_found=false
+  for artifact in "${artifacts[@]}"; do
+    read -r artifact_name _ < <(pacman -Qp "$artifact")
+    [[ $artifact_name == "$pkg" ]] && primary_found=true
+    # Match package metadata, not just filename prefixes: t1bridge, its DKMS
+    # package and its desktop integration must not delete one another.
+    for previous in "$offline_mirror_dir/$artifact_name-"*.pkg.tar.zst; do
+      [[ -f $previous ]] || continue
+      read -r previous_name _ < <(pacman -Qp "$previous")
+      [[ $previous_name == "$artifact_name" ]] || continue
+      rm -f "$previous" "$previous.sig"
+    done
+    cp "$artifact" "$offline_mirror_dir/"
+    rm -f "$offline_mirror_dir/$(basename "$artifact").sig"
+    cached="/var/cache/pacman/pkg/$(basename "$artifact")"
+    rm -f "$cached.sig"
+    cp "$artifact" "$cached"
+    repo-add "$offline_mirror_dir/intel-mac-local.db.tar.gz" "$artifact"
+  done
+  if ! $primary_found; then
+    failed+=("$pkg")
+    echo "ERROR: successful build produced no primary archive for $pkg." >&2
+  fi
+done < /builder/intel-mac.packages
+
+if (( ${#failed[@]} )); then
+  printf 'ERROR: failed companion builds: %s\n' "${failed[*]}" >&2
+  exit 1
+fi
