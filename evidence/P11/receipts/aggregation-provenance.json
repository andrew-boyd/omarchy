    "removed_exact_source_blocks": {
      "install/hardware/apple/fix-cs4208-audio.sh": [
        "  sleep_config_dir=\"${OMARCHY_SLEEP_CONFIG_DIR:-/etc/systemd/sleep.conf.d}\"\n  install -Dm644 \\\n    \"$OMARCHY_INSTALL/hardware/apple/60-cs4208-s2idle.conf\" \\\n    \"$sleep_config_dir/60-cs4208-s2idle.conf\"\n\n"
      ],
      "migrations/1789869577.sh": [
        "sleep_config_dir=\"${OMARCHY_SLEEP_CONFIG_DIR:-/etc/systemd/sleep.conf.d}\"\n",
        "sleep_config_source=\"$OMARCHY_PATH/install/hardware/apple/60-cs4208-s2idle.conf\"\nsleep_config_target=\"$sleep_config_dir/60-cs4208-s2idle.conf\"\nif ! cmp -s \"$sleep_config_source\" \"$sleep_config_target\"; then\n  sudo install -Dm644 \"$sleep_config_source\" \"$sleep_config_target\"\nfi\n\n"
      ],
      "manual/44-mac-support.md": [
        "The CS4208 speaker amplifier does not recover after deep S3 suspend, even when the codec is fully reinitialized. Omarchy therefore uses suspend-to-idle on these two models so audio keeps working after resume. This consumes more battery while suspended than deep S3.\n\n"
      ],
      "test/shell.d/cs4208-audio-test.sh": [
        "if ! grep -Fxq 'SuspendState=mem' \"$sleep_config\" ||\n  ! grep -Fxq 'MemorySleepMode=s2idle' \"$sleep_config\"; then\n  fail \"the CS4208 suspend override selects s2idle\"\nfi\n"
      ]
    },
    "excluded_file": "install/hardware/apple/60-cs4208-s2idle.conf",
    "test_replacements": [
      {
        "path": "test/shell.d/cs4208-audio-test.sh",
        "before": "[[ -f $test_tmp/leaf-sleep-MacBook10,1/60-cs4208-s2idle.conf ]] ||\n  fail \"hardware setup selects s2idle for reliable speaker resume\"",
        "after": "[[ ! -e $test_tmp/leaf-sleep-MacBook10,1/60-cs4208-s2idle.conf ]] ||\n  fail \"audio aggregation leaves hardware sleep policy untouched\""
