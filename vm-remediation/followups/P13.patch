   run_migration
@@ -116,7 +116,7 @@ for vendor in 'Apple Inc.' 'Apple Computer, Inc.' 'Apple' 'Appleish'; do
   pass "source Apple-prefix policy skips $vendor without changing boot order"
 done
 
-for vendor in 'Dell Inc.' 'apple Inc.' ''; do
