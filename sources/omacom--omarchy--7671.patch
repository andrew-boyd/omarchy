+[[ -f "$(generic)" ]] || fail "the migration installs NVRAM on an existing Mac"
+expected=macaddr=aa:bb:cc:dd:ee:ff
+[[ -n $expected ]] || fail "expected macaddr is non-empty"
+grep -Fqx "$expected" "$(generic)" ||
