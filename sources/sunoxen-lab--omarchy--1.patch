diff --git a/default/wireplumber/wireplumber.conf.d/51-macbook-cs4208-softvol.conf b/default/wireplumber/wireplumber.conf.d/51-macbook-cs4208-softvol.conf
new file mode 100644
index 00000000000..2da764623a0
--- /dev/null
+++ b/default/wireplumber/wireplumber.conf.d/51-macbook-cs4208-softvol.conf
@@ -0,0 +1,17 @@
+# The 12-inch MacBook's CS4208 speaker path has no usable hardware volume.
+# Keep its hardware mixer at full scale and apply volume in software instead.
+
+monitor.alsa.rules = [
+  {
+    matches = [
+      {
+        device.name = "alsa_card.pci-0000_00_1f.3"
+      }
+    ]
+    actions = {
+      update-props = {
+        api.alsa.soft-mixer = true
+      }
+    }
+  }
+]
