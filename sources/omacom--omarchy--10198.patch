+await_evals() {
+  local waited lines
+
+  for (( waited = 0; waited < 100; waited++ )); do
+    lines=$(wc -l <"$eval_log" | tr -d ' ')
+    (( lines >= $1 )) && return 0
+    sleep 0.05
