+fi
diff --git a/install/hardware/apple/macbook-nvme-suspend b/install/hardware/apple/macbook-nvme-suspend
new file mode 100755
index 00000000000..73092bffa94
--- /dev/null
+++ b/install/hardware/apple/macbook-nvme-suspend
@@ -0,0 +1,18 @@
+#!/bin/bash
+
+set -euo pipefail
+
+nvme_sysfs="${OMARCHY_MACBOOK_NVME_SYSFS:-/sys/class/nvme}"
+found=0
+
+shopt -s nullglob
+for setting in "$nvme_sysfs"/nvme*/device/d3cold_allowed; do
+  [[ -f $setting ]] || continue
+  printf '0\n' >"$setting"
+  echo "Disabled D3cold for $(basename "$(dirname "$(dirname "$setting")")")"
+  found=1
+done
+
+if (( found == 0 )); then
+  echo "No NVMe controller exposes d3cold_allowed; nothing to change"
+fi
diff --git a/install/hardware/apple/mbp133-amdgpu-stability b/install/hardware/apple/mbp133-amdgpu-stability
new file mode 100755
index 00000000000..6ac96eae2e7
--- /dev/null
+++ b/install/hardware/apple/mbp133-amdgpu-stability
@@ -0,0 +1,82 @@
+#!/bin/bash
+
+set -euo pipefail
+
+dmi_product="${OMARCHY_MBP133_DMI_PRODUCT:-/sys/class/dmi/id/product_name}"
+pci_devices="${OMARCHY_MBP133_PCI_DEVICES:-/sys/bus/pci/devices}"
+
+[[ $(cat "$dmi_product" 2>/dev/null || true) == "MacBookPro13,3" ]] || {
+  echo "Skipping Radeon workaround: this is not a MacBookPro13,3"
+  exit 0
+}
+
+gpu=""
+for candidate in "$pci_devices"/*; do
+  [[ -f $candidate/vendor && -f $candidate/device ]] || continue
+  [[ $(<"$candidate/vendor") == 0x1002 ]] || continue
+  [[ $(<"$candidate/device") == 0x67ef ]] || continue
+  [[ $(<"$candidate/subsystem_vendor") == 0x106b ]] || continue
+  [[ $(<"$candidate/subsystem_device") == 0x0160 ]] || continue
+  gpu=$candidate
+  break
+done
+
+[[ -n $gpu ]] || {
+  echo "Skipping Radeon workaround: Apple Radeon Pro 460 was not found"
+  exit 0
+}
+
+for _ in {1..100}; do
+  if [[ -e $gpu/power_dpm_force_performance_level && \
+        -e $gpu/pp_dpm_sclk && \
+        -e $gpu/pp_dpm_mclk && \
+        -e $gpu/pp_dpm_pcie ]]; then
+    break
+  fi
+  sleep 0.1
+done
+
+for control in power_dpm_force_performance_level pp_dpm_sclk pp_dpm_mclk pp_dpm_pcie; do
+  [[ -e $gpu/$control ]] || {
+    echo "Missing AMDGPU control: $gpu/$control" >&2
+    exit 1
+  }
+done
+
+clock_levels() {
+  awk -F: '/^[[:space:]]*[0-9]+:/ {
+    level=$1
+    gsub(/[[:space:]]/, "", level)
+    print level
+  }' "$1"
+}
+
+sclk_levels=$(clock_levels "$gpu/pp_dpm_sclk" | paste -sd' ' -)
+mclk_level=$(clock_levels "$gpu/pp_dpm_mclk" | tail -n 1)
+pcie_levels=$(clock_levels "$gpu/pp_dpm_pcie" | paste -sd' ' -)
+
+[[ -n $sclk_levels && -n $mclk_level && -n $pcie_levels ]] || {
+  echo "Could not determine the Radeon DPM clock levels" >&2
+  exit 1
+}
+
+printf '%s\n' manual | tee "$gpu/power_dpm_force_performance_level" >/dev/null
+printf '%s\n' "$sclk_levels" | tee "$gpu/pp_dpm_sclk" >/dev/null
+printf '%s\n' "$mclk_level" | tee "$gpu/pp_dpm_mclk" >/dev/null
+printf '%s\n' "$pcie_levels" | tee "$gpu/pp_dpm_pcie" >/dev/null
+
+if [[ ${OMARCHY_MBP133_VERIFY_DPM:-1} == 1 ]]; then
+  for _ in {1..20}; do
+    if grep -Eq "^[[:space:]]*$mclk_level:.*\\*" "$gpu/pp_dpm_mclk"; then
+      echo "MacBookPro13,3 Radeon workaround active: MCLK level $mclk_level pinned;" \
+        "SCLK and PCIe may scale"
+      exit 0
+    fi
+    sleep 0.1
+  done
+
+  echo "AMDGPU did not enter the requested MCLK level $mclk_level" >&2
+  exit 1
+fi
+
+echo "MacBookPro13,3 Radeon workaround wrote MCLK level $mclk_level"
diff --git a/install/hardware/apple/mbp133-amdgpu-stability-monitor b/install/hardware/apple/mbp133-amdgpu-stability-monitor
new file mode 100755
index 00000000000..99a749988cc
--- /dev/null
+++ b/install/hardware/apple/mbp133-amdgpu-stability-monitor
@@ -0,0 +1,77 @@
+#!/bin/bash
+
+set -u -o pipefail
+
+dmi_product="${OMARCHY_MBP133_DMI_PRODUCT:-/sys/class/dmi/id/product_name}"
+pci_devices="${OMARCHY_MBP133_PCI_DEVICES:-/sys/bus/pci/devices}"
+apply_helper="${OMARCHY_MBP133_APPLY_HELPER:-/etc/omarchy/hardware/mbp133-amdgpu-stability}"
+apply_timeout="${OMARCHY_MBP133_APPLY_TIMEOUT:-10}"
+
+[[ $(cat "$dmi_product" 2>/dev/null || true) == "MacBookPro13,3" ]] || exit 0
+
+gpu=""
+for candidate in "$pci_devices"/*; do
+  [[ -f $candidate/vendor && -f $candidate/device ]] || continue
+  [[ $(<"$candidate/vendor") == 0x1002 ]] || continue
+  [[ $(<"$candidate/device") == 0x67ef ]] || continue
+  [[ $(<"$candidate/subsystem_vendor") == 0x106b ]] || continue
+  [[ $(<"$candidate/subsystem_device") == 0x0160 ]] || continue
+  gpu=$candidate
+  break
+done
+[[ -n $gpu ]] || exit 0
+
+stop_after_io_failure() {
+  local detail=$1
+  local message="Radeon DPM controls are unavailable ($detail); stopping the watchdog until its next service start to avoid a GPU recovery retry storm"
+  logger -t mbp133-amdgpu-stability "$message"
+  printf '%s\n' "$message" >&2
+  exit 0
+}
+
+read_control() {
+  local path=$1 value
+  if ! IFS= read -r value <"$path"; then
+    return 1
+  fi
+  printf '%s\n' "$value"
+}
+
+mclk_is_highest() {
+  local contents line level highest="" active=""
+
+  contents=$(cat "$gpu/pp_dpm_mclk") || return 2
+  while IFS= read -r line; do
+    if [[ $line =~ ^[[:space:]]*([0-9]+): ]]; then
+      level=${BASH_REMATCH[1]}
+      highest=$level
+      [[ $line == *'*'* ]] && active=$level
+    fi
+  done <<<"$contents"
+
+  [[ -n $highest && $active == "$highest" ]]
+}
+
+started=${SECONDS:-0}
+while true; do
+  force=$(read_control "$gpu/power_dpm_force_performance_level") || \
+    stop_after_io_failure "cannot read power_dpm_force_performance_level"
+
+  mclk_status=0
+  mclk_is_highest || mclk_status=$?
+  (( mclk_status == 2 )) && stop_after_io_failure "cannot read pp_dpm_mclk"
+
+  if [[ $force != "manual" ]] || (( mclk_status != 0 )); then
+    if timeout --kill-after=2s "${apply_timeout}s" "$apply_helper"; then
+      logger -t mbp133-amdgpu-stability "Reapplied the highest MCLK mask after its state changed"
+    else
+      stop_after_io_failure "the MCLK apply helper failed"
+    fi
+  fi
+
+  if (( SECONDS - started < 90 )); then
+    sleep 0.25
+  else
+    sleep 2
+  fi
+done
