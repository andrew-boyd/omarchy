diff --git a/default/systemd/system-sleep/wake-session b/default/systemd/system-sleep/wake-session
new file mode 100755
index 00000000000..107a6408044
--- /dev/null
+++ b/default/systemd/system-sleep/wake-session
@@ -0,0 +1,23 @@
+#!/bin/bash
+
+# After S3, Hyprland has often missed the lid-open switch because user.slice
+# was frozen. Turn the panel back on once the session can run again.
+
+if [[ $1 != post ]]; then
+  exit 0
+fi
+
+# user.slice is still frozen here; a synchronous call would block thaw.
+(
+  sleep 1
+  for uid_dir in /run/user/*; do
+    [[ -S $uid_dir/bus ]] || continue
+    uid=${uid_dir##*/}
+    [[ $uid =~ ^[0-9]+$ ]] || continue
+    sudo -u "#$uid" env \
+      XDG_RUNTIME_DIR="$uid_dir" \
+      DBUS_SESSION_BUS_ADDRESS="unix:path=$uid_dir/bus" \
+      WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
+      omarchy-system-lid-open >/dev/null 2>&1 || true
+  done
+) &
diff --git a/etc/systemd/logind.conf.d/30-lid-ignore.conf b/etc/systemd/logind.conf.d/30-lid-ignore.conf
new file mode 100644
index 00000000000..eca7ed8d492
--- /dev/null
+++ b/etc/systemd/logind.conf.d/30-lid-ignore.conf
@@ -0,0 +1,7 @@
+# Hyprland owns lid-close: lock immediately, then debounce before suspend.
+# If logind also HandleLidSwitch=suspend, a 2s close/open commits to S3 with
+# the lid already open. user.slice is frozen, so Hyprland never sees the open
+# and the panel stays dark.
+[Login]
+HandleLidSwitch=ignore
+HandleLidSwitchExternalPower=ignore
diff --git a/manual/36-system-sleep.md b/manual/36-system-sleep.md
index df6c8174518..36bbf6aac36 100644
--- a/manual/36-system-sleep.md
+++ b/manual/36-system-sleep.md
@@ -2,6 +2,8 @@
 
 Omarchy enables suspend and hibernation by default, but if you're having issues with either on your machine, you can toggle them off.
 
+Closing a laptop lid locks immediately, then suspends a couple of seconds later if the lid is still shut. That delay is so a quick close/open does not put the machine to sleep with the lid already open. 2016–2017 MacBook Pros wait 20 seconds instead, because leaving S3 on those machines takes long enough that a short close would still feel like a hang. Any machine can set the wait in `/etc/omarchy/lid-suspend-delay` (one number, seconds). Docked (clamshell) lid close stays awake on the external display.
+
 ### Power profiles
 
 On a laptop, Omarchy remembers your power profile separately for plugged in and running on battery, and switches between the two as you plug and unplug. Out of the box that means performance on AC and balanced on battery.
diff --git a/migrations/1789604767.sh b/migrations/1789604767.sh
new file mode 100644
index 00000000000..e5dd0a982ea
--- /dev/null
+++ b/migrations/1789604767.sh
@@ -0,0 +1,16 @@
+echo "Stop logind suspending on lid close so Hyprland can debounce"
+
+dropin=/etc/systemd/logind.conf.d/30-lid-ignore.conf
+src="$OMARCHY_PATH/etc/systemd/logind.conf.d/30-lid-ignore.conf"
+
+if [[ -f $src && ! -f $dropin ]]; then
+  sudo install -Dm644 "$src" "$dropin"
+fi
+
+[[ -f $dropin ]] || exit 0
+
+if ! grep -q '^HandleLidSwitch=ignore' "$dropin"; then
+  exit 0
+fi
+
+sudo systemctl reload systemd-logind.service
