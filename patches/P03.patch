-    PACKAGES+=("${VULKAN_DRIVERS[$vendor]}")
-  fi
+add_vulkan_pkg() {
+  local pkg=$1
+  local existing
+  for existing in "${PACKAGES[@]+"${PACKAGES[@]}"}"; do
+    [[ $existing == "$pkg" ]] && return
+  done
+  PACKAGES+=("$pkg")
+}
+
+shopt -s nullglob
+for device in "$pci_devices_path"/*; do
+  [[ -r $device/vendor && -r $device/class ]] || continue
+  [[ $(<"$device/class") == 0x03* ]] || continue
