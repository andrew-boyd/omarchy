+setup_scenario touch_bar 0 1
+cp "$ROOT/bin/omarchy-hyprland-monitor-external-active" "$mock_bin/omarchy-hyprland-monitor-external-active"
+cat >"$mock_bin/hyprctl" <<'SH'
