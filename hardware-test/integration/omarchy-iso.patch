@@ -0,0 +1,18 @@
+#!/bin/bash
+# The baseline requests this offline firmware, but the current arch-mact2
+# database lists only a fetcher. Preserve the maintainer's original artifact.
+set -euo pipefail
+mirror=$1
+filename=apple-bcm-firmware-14.0-1-any.pkg.tar.zst
+url="https://github.com/NoaHimesaka1873/arch-mact2-mirror/releases/download/release/$filename"
+# SHA256 published on the maintainer's GitHub release asset (2026-09-16).
+expected=f2cd47d9e3fb9658f16997b2d9ace3033b57925b8c6ddd86ccc3d07d0c3e9559
+mkdir -p "$mirror"
+if ! (cd "$mirror" && printf '%s  %s\n' "$expected" "$filename" | sha256sum -c --status); then
+  curl -fL --retry 2 --output "$mirror/$filename.download" "$url"
+  printf '%s  %s\n' "$expected" "$mirror/$filename.download" | sha256sum -c
+  mv "$mirror/$filename.download" "$mirror/$filename"
+fi
+[[ $(pacman -Qp "$mirror/$filename") == 'apple-bcm-firmware 14.0-1' ]]
+rm -f "$mirror/$filename.sig"
+printf 'Pinned baseline firmware: %s (%s)\n' "$url" "$expected"
