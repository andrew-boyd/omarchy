diff --git a/test/shell.d/factory-reset-boot-test.sh b/test/shell.d/factory-reset-boot-test.sh
new file mode 100644
index 00000000..8c94b7ef
--- /dev/null
+++ b/test/shell.d/factory-reset-boot-test.sh
@@ -0,0 +1,90 @@
+#!/bin/bash
+set -euo pipefail
+source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
+
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT
+awk '/^[a-z_]+\(\) \{/ { copying = 1 } copying { print } /^}/ { copying = 0 }' \
+  "$ROOT/bin/omarchy-system-factory-reset" >"$scratch/functions"
+source "$scratch/functions"
+fail() { echo "not ok - $*" >&2; exit 1; }
+old=11111111111111111111111111111111
+new=22222222222222222222222222222222
+foreign=33333333333333333333333333333333
+LOG_FILE="$scratch/reset.log"
+root="$scratch/root"
+mkdir -p "$root/etc" "$root/boot/$old" "$root/boot/$foreign" "$root/usr/share/omarchy/default/limine"
+printf '%s\n' "$new" >"$root/etc/machine-id"
+echo private >"$root/boot/$old/marker"
+echo foreign >"$root/boot/$foreign/marker"
+echo template >"$root/usr/share/omarchy/default/limine/limine.conf"
+cat >"$root/boot/limine.conf" <<EOF
+interface_branding: Custom shared boot
+/Windows
+protocol: efi
+path: boot():/EFI/Microsoft/Boot/bootmgfw.efi
+/+Foreign
+comment: machine-id=$foreign order-priority=50
+ //linux
+ protocol: efi
+ path: boot():/EFI/Linux/foreign.efi
+EOF
+cp "$root/boot/limine.conf" "$scratch/foreign.conf"
+# The installed boot parser gets its own real shared-ESP VM test. Here its
+# contract is a successful removal with no other configuration edits needed.
+chroot() {
+  [[ $* == "$root /usr/bin/limine-entry-tool --no-hooks --remove-entry $old" ]] || return 80
+  [[ ${PARSER_FAIL:-0} == 0 ]]
+}
+reset_limine_config "$root" /boot "$old"
+cmp "$scratch/foreign.conf" "$root/boot/limine.conf" || fail "foreign boot configuration survives"
+[[ -f $root/boot/$foreign/marker && ! -e $root/boot/$old ]] || fail "only old identity directory is removed"
+pass "reset preserves foreign configuration and deletes only the known old identity directory"
+reset_limine_config "$root" /boot "$old"
+pass "repeating boot cleanup preserves the same foreign state"
+mkdir -p "$root/boot/$old"
+if (PARSER_FAIL=1 reset_limine_config "$root" /boot "$old") >/dev/null 2>&1; then fail "parser failure aborts cleanup"; fi
+[[ -d $root/boot/$old ]] || fail "parser failure retains old directory"
+pass "a parser failure prevents directory deletion"
+for invalid in '' ../escape "$new"; do
+  if (reset_limine_config "$root" /boot "$invalid") >/dev/null 2>&1; then fail "invalid identity rejected"; fi
+done
+pass "missing, unsafe and unchanged machine identities cannot delete boot state"
+cat >>"$root/boot/limine.conf" <<EOF
+/+Fresh Omarchy
+comment: machine-id=$new order-priority=50
+ //linux-omarchy
+ protocol: efi
+ path: boot():/EFI/Linux/omarchy_linux-omarchy.efi
+default_entry: 2
+remember_last_entry: yes
+EOF
+select_reset_boot_entry "$root" /boot
+[[ $(head -n 1 "$root/boot/limine.conf") == 'default_entry: Fresh Omarchy/linux-omarchy' ]] || fail "the default is a global before all menu entries"
+grep -Fxq 'default_entry: Fresh Omarchy/linux-omarchy' "$root/boot/limine.conf" || fail "the new bootable child is selected after foreign entries"
+grep -Fxq 'remember_last_entry: no' "$root/boot/limine.conf" || fail "remembered foreign entry cannot override reset boot"
+[[ $(grep -ci '^default_entry:' "$root/boot/limine.conf") == 1 ]] || fail "default is replaced exactly once"
+cp "$root/boot/limine.conf" "$scratch/selected.conf"
+select_reset_boot_entry "$root" /boot
+cmp "$scratch/selected.conf" "$root/boot/limine.conf" || fail "repeated boot selection preserves exact configuration"
+pass "reset chooses its new bootable entry without choosing a foreign OS or directory"
+printf '%s\n' 44444444444444444444444444444444 >"$root/etc/machine-id"
+if (select_reset_boot_entry "$root" /boot) >/dev/null 2>&1; then fail "missing bootable new identity rejected"; fi
+pass "reset refuses a menu with no bootable entry for its new identity"
+
+# The second reset phase must preserve the same shared ESP. Read its actual
+# functions while redirecting only the machine identity read into our fixture.
+awk '/^limine_entries_stale\(\)/,/^}/; /^reset_limine_config\(\)/,/^}/' \
+  "$ROOT/bin/omarchy-provision-owner" | sed "s|cat /etc/machine-id|cat $root/etc/machine-id|" >"$scratch/owner-functions"
+source "$scratch/owner-functions"
+esp_path() { printf '%s\n' "$root/boot"; }
+OMARCHY_PATH="$root/usr/share/omarchy"
+printf '%s\n' "$new" >"$root/etc/machine-id"
+cp "$root/boot/limine.conf" "$scratch/owner-before.conf"
+if limine_entries_stale; then fail "foreign identities do not make the current entry stale"; fi
+reset_limine_config
+cmp "$scratch/owner-before.conf" "$root/boot/limine.conf" || fail "provisioning preserves the shared menu"
+[[ -f $root/boot/$foreign/marker ]] || fail "provisioning preserves foreign directories"
+printf '%s\n' 44444444444444444444444444444444 >"$root/etc/machine-id"
+limine_entries_stale || fail "a missing current identity still needs rebuilding"
+pass "first-boot provisioning preserves foreign entries and repairs only a missing current identity"
