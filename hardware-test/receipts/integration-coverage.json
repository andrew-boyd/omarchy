      "reason": "Published companion retains stable omarchy>=4.0.1. The combined build explicitly substitutes the exact local omarchy-dev dependency and local pkgrel when the builder opts in.",
      "diff": "--- P12-packages/pkgbuilds/t1bridge-omarchy/PKGBUILD\n+++ combined/pkgbuilds/t1bridge-omarchy/PKGBUILD\n@@ -4,7 +4,19 @@\n pkgdesc='Optional Omarchy desktop integration for T1Bridge'\n arch=('any')\n license=('MIT')\n-depends=('brightnessctl' 'coreutils' 'iio-sensor-proxy' 'bash' 'gawk' 'jq' 'libpulse' 'omarchy>=4.0.1' 'systemd' 't1bridge>=0.1.0')\n+_omarchy_dependency='omarchy>=4.0.1'\n+# Local integration ISOs test a pinned quattro runtime whose version is below\n+# the stable release. Keep the released dependency unless the builder opts in\n+# with the exact version read from its actual omarchy-dev package archive.\n+if [[ -n ${OMARCHY_LOCAL_RUNTIME_DEPENDENCY:-} ]]; then\n+  if [[ ! $OMARCHY_LOCAL_RUNTIME_DEPENDENCY =~ ^omarchy-dev=[[:alnum:]][[:alnum:].:+_~-]*$ ]]; then\n+    printf 'Invalid exact local Omarchy dependency: %s\\n' \"$OMARCHY_LOCAL_RUNTIME_DEPENDENCY\" >&2\n+    return 1\n+  fi\n+  _omarchy_dependency=$OMARCHY_LOCAL_RUNTIME_DEPENDENCY\n+  pkgrel=2.1\n+fi\n+depends=('brightnessctl' 'coreutils' 'iio-sensor-proxy' 'bash' 'gawk' 'jq' 'libpulse' \"$_omarchy_dependency\" 'systemd' 't1bridge>=0.1.0')\n makedepends=('make')\n checkdepends=('diffutils')\n source=(\"$pkgname-$pkgver.tar.gz::https://linux.standardagents.ai/arch/standardagents/x86_64/$pkgname-$pkgver.tar.gz\"\n"
    },
